{
    "name": "hampel/json",
    "description": "A simple wrapper for json_encode and json_decode with exception based error handling",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/json/issues",
        "source": "https://github.com/hampel/json"
    },
    "keywords": [
        "json"
    ],
    "homepage": "https://github.com/hampel/json",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\Json\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\Json\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
